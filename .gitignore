# Secrets / credentials
.env

# Procurement-sensitive working file - NOT for the public Pages site.
# GitHub Pages serves the repo, so anything committed under data/ is reachable by URL.
data/vendors.csv

# Data engineering: source snapshots, intermediates, outputs, logs (never commit)
data/raw/
data/processed/
outputs/
logs/
*.gdb/
*.gpkg

# Climate pipeline (climate/) - downloaded data never committed
climate/data/
climate/outputs/
climate/logs/
climate/.env
*.nc
*.zarr/
*.tif

# Debris-flow pipeline (debris-flow/) - inputs and wildcat project runs never committed
# (outputs/ and logs/ are already covered by the unanchored patterns above)
debris-flow/data/
debris-flow/projects/
debris-flow/.env

# Jupyter
.ipynb_checkpoints/
__pycache__/
*.pyc

# OS / editor cruft
.DS_Store
Thumbs.db
*.tmp

# RA2CE large geodata outputs - too large for GitHub (analysis outputs, not source)
scripts/ra2ce/output/
scripts/ra2ce/static/output_graph/

# RA2CE rerun outputs. The geopackages / feather graphs run 20-440 MB each (GitHub
# hard-rejects anything over 100 MB) and the per-OD route tables are 34-66 MB, so
# none of them are committed - the notebook regenerates them. Summary PNGs and the
# small weights CSVs alongside them stay tracked.
scripts/ra2ce/output_rerun/**/*.gpkg
scripts/ra2ce/output_rerun/**/*.feather
scripts/ra2ce/output_rerun/optimal_route_origin_destination/*.csv
scripts/ra2ce/output_rerun/*.parquet

# ArcGIS file geodatabases. A .gdb is a directory of binary tables that ArcGIS Pro
# rewrites in place, so it neither diffs nor merges - treat the whole thing as an
# output no matter where a script drops it.
*.gdb/

# Shapefiles and dbf tables - regenerated from the source GDB / SDE by the
# notebooks, so they are outputs rather than source. Every sidecar counts:
# a shapefile is unusable if one of .shp / .shx / .dbf / .prj goes missing.
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.CPG
*.sbn
*.sbx
*.qix
*.qpj
*.shp.xml
*.shp.*.sr.lock

# Non-shapefile geodata written alongside the above (GeoPackage / GeoJSON
# copies of the same networks). CSVs are deliberately NOT ignored - the
# *_weights.csv files record the weights an analysis actually ran with.
scripts/ra2ce/static/network/*.gpkg
scripts/ra2ce/static/network/*.geojson

# Raw internal source docs (per CLAUDE.md rule: never commit xlsx/docx/pptx
# working files - GitHub Pages serves the repo publicly)
data/*.xlsx
docs/*.xlsx
*.docx
*.pptx

# Internal coordination notes - working content for the team, not for the
# public Pages site (repo review 2026-08-01, item 1.5)
docs/index-copy.txt
docs/coordination_notes.md
